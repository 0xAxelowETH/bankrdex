# Copy to .env.local and provide credentials through a secure secret store.
# Never commit real API keys, passwords, or service-role keys.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id

# Server-only aggregator credentials (OKX DEX and Binance Web3 must have Base, chain 8453, enabled)
OKX_DEX_PROJECT_ID=replace-with-okx-project-id
OKX_DEX_API_KEY=replace-with-okx-api-key
OKX_DEX_SECRET_KEY=replace-with-okx-secret-key
OKX_DEX_PASSPHRASE=replace-with-okx-passphrase
BINANCE_WEB3_API_KEY=replace-with-binance-web3-api-key
BINANCE_WEB3_SECRET_KEY=replace-with-binance-web3-secret-key

# Server-only Supabase cache (service role must never be NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Signs the wallet sign-in cookie for profiles and theses (32+ random characters).
SESSION_SECRET=replace-with-32-plus-random-characters

# Optional: shared rate limiting across serverless instances (Upstash Redis REST).
# Without these, each instance rate-limits in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: error reporting (Sentry). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: set to 1 after enabling Web Analytics in the Vercel dashboard.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Optional: Telegram alerts (fee received, services down). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret for the scheduler calling /api/cron/notify (any long random string).
CRON_SECRET=
# Optional: key for the visitor dashboard at /admin/stats. Falls back to CRON_SECRET.
STATS_SECRET=

# Optional: archive-capable Base RPC for the launch registry catch-up (default: Tenderly public gateway).
BASE_ARCHIVE_RPC=
